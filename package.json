{
    "name": "bkoi-gl",
    "version": "3.3.0",
    "description": "A WebGL interactive maps library to use Barikoi maps and API",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        },
        "./style.css": {
            "default": "./dist/style/bkoi-gl.css"
        },
        "./dist/style/bkoi-gl.css": {
            "default": "./dist/style/bkoi-gl.css"
        },
        "./worker": {
            "types": "./dist/bkoi-map-worker.d.mts",
            "default": "./dist/bkoi-map-worker.mjs"
        }
    },
    "style": "./dist/style/bkoi-gl.css",
    "author": "barikoi",
    "readme": "README.md",
    "license": "MIT",
    "homepage": "https://docs.barikoi.com/docs/maps-api",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/barikoi/bkoi-gl-js.git"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": [
        "*.css",
        "./dist/style/**/*.css"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "npm run typecheck && rollup --config && node scripts/build-worker.mjs",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:cache": "eslint . --cache",
        "lint:fix:cache": "eslint . --fix --cache",
        "test": "vitest run --coverage",
        "test:watch": "vitest --watch",
        "test:unit": "vitest run --project unit",
        "test:browser": "vitest run --project browser",
        "e2e": "npm run build && node scripts/extract-readme-examples.mjs && playwright test",
        "e2e:serve": "vite tests/e2e/app --port 5176 --strictPort",
        "test:framework": "node tests/framework/run.mjs",
        "test:resolution": "node scripts/test-resolution.mjs",
        "test:pack": "node scripts/test-pack.mjs",
        "playwright:install": "playwright install chromium",
        "prepublishOnly": "npm run typecheck && npm run lint && vitest run && npm run build"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "maplibre-gl": "6.6.0",
        "maplibre-gl-draw": "1.6.9"
    },
    "devDependencies": {
        "@commitlint/cli": "19.4.1",
        "@commitlint/config-conventional": "19.4.1",
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "9.39.2",
        "@rollup/plugin-babel": "6.0.4",
        "@rollup/plugin-commonjs": "26.0.1",
        "@rollup/plugin-image": "3.0.3",
        "@rollup/plugin-node-resolve": "15.2.3",
        "@rollup/plugin-terser": "1.0.0",
        "@rollup/plugin-typescript": "11.1.6",
        "@types/node": "25.0.3",
        "@typescript-eslint/eslint-plugin": "8.50.1",
        "@typescript-eslint/parser": "8.50.1",
        "@vitest/browser": "4.1.11",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "esbuild": "0.25.12",
        "eslint": "9.39.2",
        "eslint-config-mourner": "3.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import": "2.31.0",
        "eslint-plugin-prettier": "5.5.5",
        "globals": "17.3.0",
        "husky": "9.1.5",
        "jsdom": "29.1.1",
        "lint-staged": "16.2.7",
        "playwright": "1.63.0",
        "prettier": "3.8.1",
        "rollup": "4.63.3",
        "rollup-plugin-clear": "2.0.7",
        "rollup-plugin-copy": "3.5.0",
        "rollup-plugin-dts": "6.3.0",
        "tslib": "2.8.1",
        "typescript": "5.9.3",
        "vite": "7.3.6",
        "vitest": "4.1.11"
    },
    "keywords": [
        "bkoi-gl",
        "barikoi",
        "bangladesh",
        "location",
        "geocoding",
        "reverse-geocoding",
        "autocomplete",
        "api",
        "maps",
        "maplibre",
        "webgl",
        "address",
        "location-data",
        "geospatial",
        "address-lookup",
        "places",
        "geocoding-api",
        "location-api",
        "mapping",
        "gis",
        "drawing",
        "polygon"
    ]
}
